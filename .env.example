# Copy to .env.local. Nothing here is needed to run the site with the data already in data/.

# Offline scripts only (scripts/score.ts, scripts/map-local.ts). Get a key at https://typesafe.ai.
TYPESAFE_API_KEY=

# Contact form (app/api/contact/route.ts). Leave blank and the form says it isn't configured.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A Resend-verified sender, or "LA Ballot Match <onboarding@resend.dev>" while testing.
CONTACT_FROM_EMAIL=
# Any random string; signs the form's anti-spam token.
CONTACT_SECRET=

# Canonical URL for Open Graph images.
NEXT_PUBLIC_SITE_URL=
